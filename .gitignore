*.jpg
*.jpeg
generated/
exports/
reports/generated/
browser-artifacts/
browser-state/
desktop-state/
cookies/
sessions/
*cookies*.json
*session*.json
*storage-state*
production-initial-credentials.txt
*credentials*
*secret*
*password*
# Preserve necessary source code, not secret-bearing data files.
!src/**/*password*.ts
!src/**/*password*.tsx
!src/**/*secret*.ts
!src/**/*credentials*.ts
!tests/**/*password*.ts
!tests/**/*secret*.ts
!scripts/scan-secrets.mjs
*demo-accounts*
.DS_Store
Thumbs.db
.vscode/
.idea/
# SQL migrations are application source, never dumps. Keep this exception narrow.
!/prisma/migrations/**/migration.sql

