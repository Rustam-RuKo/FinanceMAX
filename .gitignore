# Default-deny root: additions require review before publication.
/*
!/.gitignore
!/.env.example
!/README.md
!/AGENTS.md
!/package.json
!/package-lock.json
!/tsconfig*.json
!/next.config.*
!/eslint.config.*
!/.prettierrc*
!/prettier.config.*
!/src/
!/prisma/
!/tests/
!/scripts/
!/docs/
!/public/

# Only reviewed operational scripts; historical source-rewriting helpers stay local.
/scripts/*
!/scripts/test.mjs
!/scripts/seed.ts
!/scripts/seed-production.mjs
!/scripts/bootstrap-production-users.ts
!/scripts/create-admin.ts
!/scripts/configure-runtime.mjs
!/scripts/production-safety.mjs
!/scripts/production-cleanup.mjs
!/scripts/scan-secrets.mjs
!/scripts/browser-fixture.ts

# Reviewed Windows deployment package only; local config stays excluded.
!/scripts/windows/
/scripts/windows/*
!/scripts/windows/install-financemax.ps1
!/scripts/windows/verify-financemax.ps1
!/scripts/windows/backup-financemax.ps1
!/scripts/windows/update-financemax.ps1
!/scripts/windows/config.example.psd1
!/scripts/windows/common.ps1
!/scripts/windows/start-runtime.ps1
!/scripts/windows/test-windows-package.ps1

# Only approved user documentation and this publication audit.
/docs/*
!/docs/РУКОВОДСТВО_ПОЛЬЗОВАТЕЛЯ_FINANCEMAX.md
!/docs/FINANCEMAX_БЫСТРЫЙ_СТАРТ.md
!/docs/FINANCEMAX_АДМИНИСТРАТОР.md
!/docs/user-guide-validation.md
!/docs/github-readiness.md
!/docs/DEPLOYMENT_СЕРВЕР_FINANCEMAX_WINDOWS.md
!/docs/FINANCEMAX_BACKUP_И_RESTORE_WINDOWS.md
!/docs/FINANCEMAX_ОБНОВЛЕНИЕ_И_ROLLBACK_WINDOWS.md
!/docs/FINANCEMAX_SERVER_CHECKLIST_WINDOWS.md
!/docs/windows-deployment-readiness.md

.env
.env.*
!.env.example
.runtime/
.next/
node_modules/
coverage/
dist/
build/
*.tsbuildinfo
*.dump
*.sql
*.bak
*.backup
*.log
*.tmp
*.xlsx
*.xls
*.csv
*.sqlite
*.sqlite3
*.db
*.pem
*.key
*.p12
*.pfx
backups/
pgdata/
postgres-data/
postgresql-data/
PG_VERSION
