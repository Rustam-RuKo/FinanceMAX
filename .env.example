# Fill locally. Never commit .env. Values below are placeholders only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:PORT/DB_NAME
APP_ORIGIN=SCHEME://HOST:PORT
TRUST_PROXY=false
FINANCEMAX_ENV=development
# One-time creation of an administrator in an empty database; remove afterwards.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Optional, only for an explicitly isolated demo database.
DEMO_PASSWORD=
# Restricted one-time production bootstrap; not ordinary installation steps.
PRODUCTION_DATABASE_URL=
PRODUCTION_SOURCE_DATABASE_URL=
# Optional PostgreSQL tools directory for maintenance; use a local path.
PG_BIN=
# Test harness options (not application configuration; normally leave empty).
TEST_FILE=
TEST_DATABASE_NAME=
PHASE6_BROWSER=
# NODE_ENV is managed by Next.js. No SESSION_SECRET/AUTH_SECRET is used.
